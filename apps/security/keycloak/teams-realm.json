{
  "realm": "teams",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "teams-ui",
      "name": "Teams UI",
      "description": "Angular Teams Management UI",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "https://teams-ui.127.0.0.1.sslip.io:8443/*",
        "http://teams-ui.127.0.0.1.sslip.io:8080/*",
        "http://platform-auth.127.0.0.1.sslip.io/*",
        "http://engineering-platform.local/*",
        "http://localhost:4200/*",
        "http://localhost:4201/*",
        "http://rdutta.coder/*"
      ],
      "webOrigins": [
        "https://teams-ui.127.0.0.1.sslip.io:8443",
        "http://teams-ui.127.0.0.1.sslip.io:8080",
        "http://platform-auth.127.0.0.1.sslip.io",
        "http://engineering-platform.local",
        "http://localhost:4200",
        "http://localhost:4201",
        "http://rdutta.coder:4200"
      ],
      "publicClient": true,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "https://teams-ui.127.0.0.1.sslip.io:8443/*##http://teams-ui.127.0.0.1.sslip.io:8080/*##http://platform-auth.127.0.0.1.sslip.io/*##http://localhost:4200/*##http://localhost:4201/*##http://rdutta.coder:*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "teams-cli",
      "name": "Teams CLI",
      "description": "Command-line client — Authorization Code + PKCE (S256), loopback redirect (RFC 8252). Public, no secret; browser flow only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8400/callback",
        "http://127.0.0.1:8400/callback",
        "http://localhost:8400",
        "http://127.0.0.1:8400"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8400/*##http://127.0.0.1:8400/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "teams-api-sa",
      "name": "Teams API service account",
      "description": "Confidential client used by teams-api to manage Keycloak groups/memberships via the Admin API (client-credentials grant). DEMO secret — rotate for real use.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-teams-api-sa-secret-change-me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "teams-operator-sa",
      "name": "Teams Operator service account",
      "description": "Confidential client for teams-operator to call teams-api's authenticated /internal/* endpoints (client-credentials grant). Unlike teams-api-sa, no realm-management roles - teams-operator never calls Keycloak's Admin API directly. DEMO secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-teams-operator-sa-secret-change-me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "teams-operator-kc-admin",
      "name": "Teams Operator Keycloak admin",
      "description": "Confidential service-account client the teams-operator reconciler uses to WRITE realm state (k8s-access {ns}-viewer/-maintainer groups, project-<slug>-owner groups, and the project-manager realm role) - see reconcile_keycloak. Client-credentials grant; the secret is delivered to the operator from OpenBao via SPIFFE (kv/platform/keycloak-admin), not a static k8s Secret. Gated OFF by KC_RECONCILE_ENABLED until cutover. DEMO secret here must match the OpenBao copy.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-teams-operator-kc-admin-secret-change-me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "argocd",
      "name": "Argo CD",
      "description": "Argo CD's native OIDC login (see platform-base/argocd.tf). clientSecret must match var.argocd_oidc_client_secret there - kept in sync by hand. DEMO secret, rotate for real use.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-argocd-oidc-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://argocd.127.0.0.1.sslip.io:8080/auth/callback"
      ],
      "webOrigins": [
        "http://argocd.127.0.0.1.sslip.io:8080"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://argocd.127.0.0.1.sslip.io:8080##http://argocd.127.0.0.1.sslip.io:8080/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "openbao",
      "name": "OpenBao",
      "description": "OpenBao's native OIDC auth method (auth/oidc) - lets users log into the OpenBao UI/CLI with their Keycloak identity. clientSecret must match auth/oidc/config's oidc_client_secret (bootstrap/README.md) - kept in sync by hand. DEMO secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-openbao-oidc-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://openbao.127.0.0.1.sslip.io:8443/ui/vault/auth/oidc/oidc/callback",
        "http://localhost:8250/oidc/callback"
      ],
      "webOrigins": [
        "https://openbao.127.0.0.1.sslip.io:8443"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://openbao.127.0.0.1.sslip.io:8443/ui/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "harbor",
      "name": "Harbor",
      "description": "Harbor's OIDC login (Administration > Configuration > Authentication, auth_mode=oidc_auth). clientSecret must match Harbor's oidc_client_secret (bootstrap/README.md) - kept in sync by hand. DEMO secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-harbor-oidc-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://harbor.127.0.0.1.sslip.io:8443/c/oidc/callback"
      ],
      "webOrigins": [
        "https://harbor.127.0.0.1.sslip.io:8443"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://harbor.127.0.0.1.sslip.io:8443/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "teamlead1",
      "enabled": true,
      "firstName": "Team",

{
  "realm": "teams",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "teams-ui",
      "name": "Teams UI",
      "description": "Angular Teams Management UI",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "https://teams-ui.127.0.0.1.sslip.io:8443/*",
        "http://teams-ui.127.0.0.1.sslip.io:8080/*",
        "http://platform-auth.127.0.0.1.sslip.io/*",
        "http://engineering-platform.local/*",
        "http://localhost:4200/*",
        "http://localhost:4201/*",
        "http://rdutta.coder/*"
      ],
      "webOrigins": [
        "https://teams-ui.127.0.0.1.sslip.io:8443",
        "http://teams-ui.127.0.0.1.sslip.io:8080",
        "http://platform-auth.127.0.0.1.sslip.io",
        "http://engineering-platform.local",
        "http://localhost:4200",
        "http://localhost:4201",
        "http://rdutta.coder:4200"
      ],
      "publicClient": true,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "https://teams-ui.127.0.0.1.sslip.io:8443/*##http://teams-ui.127.0.0.1.sslip.io:8080/*##http://platform-auth.127.0.0.1.sslip.io/*##http://localhost:4200/*##http://localhost:4201/*##http://rdutta.coder:*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "teams-cli",
      "name": "Teams CLI",
      "description": "Command-line client — Authorization Code + PKCE (S256), loopback redirect (RFC 8252). Public, no secret; browser flow only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8400/callback",
        "http://127.0.0.1:8400/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8400/*##http://127.0.0.1:8400/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "teams-api-sa",
      "name": "Teams API service account",
      "description": "Confidential client used by teams-api to manage Keycloak groups/memberships via the Admin API (client-credentials grant). DEMO secret — rotate for real use.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-teams-api-sa-secret-change-me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "openbao",
      "name": "OpenBao",
      "description": "OpenBao's native OIDC auth method (auth/oidc) - lets platform users log into the OpenBao UI/CLI with their Keycloak identity instead of a static token. Confidential; clientSecret here must match the oidc_client_secret set on OpenBao's auth/oidc/config (see bootstrap/README.md) - nothing keeps the two in sync automatically. DEMO secret — rotate for real use.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-openbao-oidc-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://openbao.127.0.0.1.sslip.io:8443/ui/vault/auth/oidc/oidc/callback",
        "http://localhost:8250/oidc/callback"
      ],
      "webOrigins": [
        "https://openbao.127.0.0.1.sslip.io:8443"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://openbao.127.0.0.1.sslip.io:8443/ui/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "harbor",
      "name": "Harbor",
      "description": "Harbor's own OIDC login provider (Administration > Configuration > Authentication, auth_mode=oidc_auth) - lets platform users log into Harbor with their Keycloak identity. Confidential; clientSecret here must match Harbor's oidc_client_secret (see bootstrap/README.md) - nothing keeps the two in sync automatically. DEMO secret — rotate for real use.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-harbor-oidc-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://harbor.127.0.0.1.sslip.io:8443/c/oidc/callback"
      ],
      "webOrigins": [
        "https://harbor.127.0.0.1.sslip.io:8443"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://harbor.127.0.0.1.sslip.io:8443/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "teamlead1",
      "enabled": true,
      "firstName": "Team",
      "lastName": "Lead",
      "email": "teamlead1@company.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["team-leader"],
      "groups": ["/team-sss"]
    },
    {
      "username": "teamlead2",
      "enabled": true,
      "firstName": "Team",
      "lastName": "Lead Two",
      "email": "teamlead2@company.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["team-leader"],
      "groups": ["/team-mmm"]
    },
    {
      "username": "viewer1",
      "enabled": true,
      "firstName": "Viewer",
      "lastName": "One",
      "email": "viewer1@company.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["viewer"],
      "groups": ["/team-sss"]
    },
    {
      "username": "admin",
      "enabled": true,
      "firstName": "Admin",
      "lastName": "User",
      "email": "admin@company.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "team-leader"]
    },
    {
      "username": "service-account-teams-api-sa",
      "enabled": true,
      "serviceAccountClientId": "teams-api-sa",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "query-users", "query-groups", "manage-realm"]
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "team-leader",
        "description": "Can create and manage teams"
      },
      {
        "name": "viewer",
        "description": "Read-only access to teams/apps"
      },
      {
        "name": "admin",
        "description": "Full administrative access"
      }
    ]
  },
  "groups": [
    { "name": "team-sss" },
    { "name": "team-mmm" }
  ]
}

      "groups": ["/team-sss"]
    },
    {
      "username": "teamlead2",
      "enabled": true,
      "firstName": "Team",
      "lastName": "Lead Two",
      "email": "teamlead2@company.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["team-leader"],
      "groups": ["/team-mmm"]
    },
    {
      "username": "viewer1",
      "enabled": true,
      "firstName": "Viewer",
      "lastName": "One",
      "email": "viewer1@company.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password123",
          "temporary": false
        }
      ],
      "realmRoles": ["viewer"],
      "groups": ["/team-sss"]
    },
    {
      "username": "admin",
      "enabled": true,
      "firstName": "Admin",
      "lastName": "User",
      "email": "admin@company.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "team-leader"],
      "groups": ["/argocd-admins"]
    },
    {
      "username": "service-account-teams-api-sa",
      "enabled": true,
      "serviceAccountClientId": "teams-api-sa",
      "clientRoles": {
        "realm-management": ["view-realm", "view-users", "query-users", "query-groups"]
      }
    },
    {
      "username": "service-account-teams-operator-sa",
      "enabled": true,
      "serviceAccountClientId": "teams-operator-sa"
    },
    {
      "username": "service-account-teams-operator-kc-admin",
      "enabled": true,
      "serviceAccountClientId": "teams-operator-kc-admin",
      "clientRoles": {
        "realm-management": ["manage-realm", "manage-users", "view-users", "query-users", "query-groups"]
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "team-leader",
        "description": "Can create and manage teams"
      },
      {
        "name": "viewer",
        "description": "Read-only access to teams/apps"
      },
      {
        "name": "admin",
        "description": "Full administrative access"
      },
      {
        "name": "project-manager",
        "description": "Can create projects and manage the ones they are assigned to (self-service Project delegation, granted by an admin)"
      }
    ]
  },
  "groups": [
    { "name": "team-sss" },
    { "name": "team-mmm" },
    { "name": "argocd-admins" }
  ]
}
